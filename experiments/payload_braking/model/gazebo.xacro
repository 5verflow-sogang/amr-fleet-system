<?xml version="1.0"?>
<!--
  Gazebo Fortress 구동 플러그인. drive_mode(V|T)에 따라 둘 중 하나만 포함한다.

  V (속도 명령, DiffDrive): 지수 amr_description과 같은 방식. accel_limited 인자로
  DiffDrive의 가속 한계 자체를 켜고/끈다 - 가속 한계는 플러그인 설정값이라 토픽으로
  나중에 바꿀 수 없고, normal/emergency stop_mode마다 다시 스폰해야 한다(README 참고).

  T (힘/토크 명령, JointController): 바퀴 조인트마다 하나씩, use_force_commands로
  속도 목표를 "추종"하되 그 과정에서 쓰는 힘을 cmd_max/cmd_min(=±wheel_torque_max)으로
  묶는다. 기본 토픽은 /model/<스폰 이름>/joint/<조인트>/cmd_vel (std_msgs/Float64,
  ignition.msgs.Double) - scripts/cmd_vel_to_wheel_torque.py가 /cmd_vel을 좌우 바퀴
  목표 각속도로 바꿔 여기로 보낸다. normal/emergency 차이는 변환 노드가 램프를
  거는지 여부뿐이라, T는 stop_mode별로 다시 스폰할 필요가 없다.

  두 모드 모두 GT(OdometryPublisher)는 그대로 켜 둔다 - 측정 스크립트가 쓰는 유일한
  진실값이다. frame은 "world"(이 월드의 원점), 속도 필드는 쓰지 말고 위치를
  미분해서 쓴다(README "측정 절차" 참고, 플러그인 속도는 이동평균이라 늦게 반응함).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:if value="${is_drive_v}">
    <gazebo>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>

        <max_linear_velocity>2.0</max_linear_velocity>
        <min_linear_velocity>-2.0</min_linear_velocity>

        <!-- accel_limited=false(emergency)면 이 네 태그를 통째로 비워 가속 한계를
             없앤다 - SpeedLimiter에 한계를 설정하지 않으면 무제한으로 동작한다. -->
        <xacro:if value="${accel_limited}">
          <max_linear_acceleration>1.0</max_linear_acceleration>
          <min_linear_acceleration>-1.0</min_linear_acceleration>
          <max_angular_acceleration>3.2</max_angular_acceleration>
          <min_angular_acceleration>-3.2</min_angular_acceleration>
        </xacro:if>

        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="${is_drive_t}">
    <gazebo>
      <!--
        힘(토크) 모드: use_force_commands=true면 cmd_vel 토픽은 여전히 "목표 각속도"지만,
        그 목표를 좇기 위해 내는 힘이 cmd_max/cmd_min으로 묶인다. 게인은 일부러 순수
        P + 크게 잡아서(5.0) 이 실험의 큰 속도 스텝(가속·급정지)에서 거의 항상
        포화(=토크 한계에 걸림) 상태로 움직이게 했다 - 목적이 "부드러운 속도 추종
        튜닝"이 아니라 "토크가 실제로 한계에 걸리는 상황"을 보는 것이기 때문이다.
      -->
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>left_wheel_joint</joint_name>
        <use_force_commands>true</use_force_commands>
        <p_gain>5.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.0</d_gain>
        <cmd_max>${wheel_torque_max}</cmd_max>
        <cmd_min>${-wheel_torque_max}</cmd_min>
      </plugin>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>right_wheel_joint</joint_name>
        <use_force_commands>true</use_force_commands>
        <p_gain>5.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.0</d_gain>
        <cmd_max>${wheel_torque_max}</cmd_max>
        <cmd_min>${-wheel_torque_max}</cmd_min>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- GT(ground truth): 측정 스크립트가 쓰는 유일한 진실값. TF로는 안 내보낸다 -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>ground_truth/odom</odom_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>${gt_rate}</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- 바퀴 각속도: 미끄러짐 감지용(측정 스크립트가 바퀴 표면 속도 = wheel_radius *
       각속도를 GT 속도와 비교한다). 드라이브 모드와 무관하게 항상 켠다 -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
