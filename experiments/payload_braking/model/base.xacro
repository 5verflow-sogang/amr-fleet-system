<?xml version="1.0"?>
<!-- base_footprint(지면) → base_link(몸체) → payload_link(적재물, 고정 조인트) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body">
        <color rgba="0.15 0.35 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- 적재물: 몸체 위 중앙에 고정. 질량은 payload_kg 인자(robot.urdf.xacro)로 바뀐다 -->
  <link name="payload_link">
    <visual>
      <geometry>
        <box size="${payload_length} ${payload_width} ${payload_height}"/>
      </geometry>
      <material name="payload">
        <color rgba="0.85 0.55 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${payload_length} ${payload_width} ${payload_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia
      m="${payload_kg if payload_kg > payload_mass_floor else payload_mass_floor}"
      x="${payload_length}" y="${payload_width}" z="${payload_height}"/>
  </link>

  <joint name="payload_joint" type="fixed">
    <parent link="base_link"/>
    <child link="payload_link"/>
    <origin xyz="0 0 ${base_height / 2 + payload_height / 2}" rpy="0 0 0"/>
  </joint>

</robot>
