# ArUco 마커를 보고 스테이션에 정밀 도킹한다 (목표 오차 2cm·1도).
# 액션 이름: docking/dock (로봇 네임스페이스 아래)
# 한 번 호출에 한 번만 시도한다. 3회 재시도는 BT가 한다 (명세의 BT 에러 자동 복구).

# ---- Goal: 요청 ----
# 도킹할 스테이션 (Task의 station_id와 같은 이름)
string station_id
---
# ---- Result: 최종 결과 ----
# error_code: Nav2 DockRobot과 같은 값. ErrorInfo 900번대로 그대로 옮긴다
uint16 NONE=0
uint16 DOCK_NOT_IN_DB=901         # 모르는 station_id
uint16 DOCK_NOT_VALID=902         # 스테이션 정보가 잘못됨
uint16 FAILED_TO_STAGE=903        # 도킹 준비 위치로 가지 못함
uint16 FAILED_TO_DETECT_DOCK=904  # ArUco 마커를 찾지 못함
uint16 FAILED_TO_CONTROL=905      # 접근 제어 실패 (오차 초과, 시간 초과)
uint16 FAILED_TO_CHARGE=906       # 충전 시작 실패 (충전 스테이션만)
uint16 UNKNOWN=999

bool success
uint16 error_code
# 시도한 횟수
uint8 attempts
# 최종 위치 오차 (m)와 방향 오차 (rad)
float32 position_error
float32 yaw_error
# 사람이 읽는 실패 사유. 성공이면 빈 문자열
string message
---
# ---- Feedback: 진행 중 보고 ----
# 현재 시도 번호 (1부터)
uint8 attempt
# 목표까지 남은 거리 (m)와 방향 오차 (rad)
float32 distance_remaining
float32 yaw_error
