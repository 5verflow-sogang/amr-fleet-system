        </visual>

        <!-- forklift_1: B-C 열 사이 통로, 직선, (-24,-6.5)->(20,-6.5), 기둥 5/6(y=-5.5) 회피 -->
        <visual name="forklift_1_path">
          <cast_shadows>false</cast_shadows>
