    <!-- ===================== 배식대 (서쪽 x -12~-6): 직원이 만든 음식을 올려 두는 배식 라인. 홀 쪽으로 열려 있다. restaurant_buffet_station(민지 #295): 길이 3.73 m, 앞뒤 1.14 m, 상판 0.89 m. 모델 +y(쟁반 받침이 튀어나온 쪽)가 손님 쪽이라 yaw pi로 남쪽(홀)을 보게 둔다. 앞면 y 4.63이 매장 카운터 앞면과 같다. 로봇은 buffet_1·2에서 받는다 ===================== -->
    <include><uri>model://restaurant_buffet_station</uri><name>buffet_line</name><pose>-9.0 5.2 0 0 0 3.1415927</pose></include>
    <!-- 배식대 뒤 직원 조리대 -->
