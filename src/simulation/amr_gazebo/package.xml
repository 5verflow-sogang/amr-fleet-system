<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_gazebo</name>
  <version>0.0.0</version>
  <description>60x40m 물류센터 월드, 동적 장애물, 센서 노이즈 모델</description>
  <maintainer email="TODO@example.com">지수</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- 동적 장애물 노드 (scripts/dynamic_obstacles_node.py) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- 연구 2 RL 평가 환경 (rl_eval.py: 2D 시나리오 난수 생성기) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <!-- rviz2는 gui 이미지에만 설치한다 (sim.launch.py rviz:=true일 때만 필요) -->

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- ros_gz_sim이 models/를 리소스 경로에 추가해 월드에서 model://<이름>으로 쓸 수 있게 한다 -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
