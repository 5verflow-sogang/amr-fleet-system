<?xml version="1.0"?>
<!--
  충전 스테이션. 모델 원점은 벽면 위의 스테이션 중심이고, +x가 창고 안쪽이다.
  - body: 충전기 본체 (x 0~0.3 m, 폭 0.6 m, 높이 0.5 m)
  - pad: 로봇이 도킹하는 위치 바닥 표시 (x 0.3~1.1 m). 충돌 없음
  ArUco 마커는 amr_docking 작업 때 본체 앞면에 붙인다.
-->
<sdf version="1.8">
  <model name="charging_station">
    <static>true</static>
    <link name="body">
      <pose>0.15 0 0.25 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>0.3 0.6 0.5</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.3 0.6 0.5</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="pad">
      <pose>0.7 0 0.006 0 0 0</pose>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>0.8 0.6 0.002</size></box>
        </geometry>
        <material>
          <ambient>0.10 0.75 0.30 1</ambient>
          <diffuse>0.10 0.75 0.30 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
