<?xml version="1.0"?>
<!-- 선반 랙. 모델 원점은 바닥 중심, 길이 방향이 x축이다. -->
<sdf version="1.8">
  <model name="warehouse_rack">
    <static>true</static>
    <link name="link">
      <pose>0 0 1.25 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>5.0 1.2 2.5</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>5.0 1.2 2.5</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.45 0.10 1</ambient>
          <diffuse>0.85 0.45 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
