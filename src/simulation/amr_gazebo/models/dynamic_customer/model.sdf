<?xml version="1.0"?>
<!--
  손님 (식당 월드 동적 장애물). dynamic_worker와 같은 구조이고 겉모습만 다르다:
  서 있는 자세의 사람 메시라 T자 자세 없이 걷는 것처럼 보인다 (다리는 움직이지 않는다).
  - VelocityControl: /model/<이름>/cmd_vel (몸체 기준 Twist)
  - OdometryPublisher: /model/<이름>/odometry (월드 기준 GT)
-->
<sdf version="1.8">
  <model name="dynamic_customer">
    <link name="link">
      <!-- dynamic_worker와 같이 중력을 끄고 충돌체를 바닥에서 띄운다 (넘어지지 않게) -->
      <gravity>false</gravity>
      <pose>0 0 0.85 0 0 0</pose>
      <inertial>
        <mass>60</mass>
        <inertia><ixx>14.8</ixx><iyy>14.8</iyy><izz>1.9</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.0125 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>1.675</length></cylinder></geometry>
      </collision>
      <!-- OpenRobotics "FemaleVisitor" (Gazebo Fuel, CC-BY 4.0), 키 1.64 m, 정면 +x. 메시 원점이 발바닥 -->
      <visual name="visual">
        <pose>0 0 -0.85 0 0 0</pose>
        <geometry>
          <mesh><uri>model://dynamic_customer/meshes/FemaleVisitor.obj</uri></mesh>
        </geometry>
      </visual>
    </link>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl"/>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <!-- YOLO 라벨 1 = 사람 (amr_gazebo README "라벨 카메라") -->
    <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
      <label>1</label>
    </plugin>
  </model>
</sdf>
