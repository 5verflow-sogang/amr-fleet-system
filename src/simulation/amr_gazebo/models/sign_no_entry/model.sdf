<?xml version="1.0"?>
<!-- 진입 금지 (빨간 원판 지름 0.4 m, 흰 가로 막대)
     모델 원점 = 판 중심, 앞면 법선 +x. 충돌체 없음(시각 전용): 표지판은 랙·벽에 붙어 바닥을 차지하지 않는다.
     LiDAR(지면 0.38 m 수평면)에 걸리지 않도록 월드에서 아랫면을 0.55 m 이상에 둔다 (README "표지판"). -->
<sdf version="1.8">
  <model name="sign_no_entry">
    <static>true</static>
    <link name="link">
      <visual name="disc">
        <pose>0.0000 0 0 0 1.5707963 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><cylinder><radius>0.2000</radius><length>0.0200</length></cylinder></geometry>
        <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <visual name="bar">
        <pose>0.0120 0.0000 0.0000 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>0.0040 0.2800 0.0700</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
