<?xml version="1.0"?>
<!--
  Gazebo Fortress 시스템 플러그인.
  Gazebo 토픽은 로봇 네임스페이스를 붙여 5대가 겹치지 않게 하고, ros_gz_bridge가 같은 이름의 ROS 토픽으로 잇는다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <!-- cmd_vel → 바퀴 속도, 바퀴 회전 → odom (odom → base_footprint TF 포함) -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>${prefix}left_wheel_joint</left_joint>
      <right_joint>${prefix}right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <min_linear_velocity>${-max_linear_velocity}</min_linear_velocity>
      <max_linear_acceleration>${max_linear_acceleration}</max_linear_acceleration>
      <min_linear_acceleration>${-max_linear_acceleration}</min_linear_acceleration>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <min_angular_velocity>${-max_angular_velocity}</min_angular_velocity>
      <max_angular_acceleration>${max_angular_acceleration}</max_angular_acceleration>
      <min_angular_acceleration>${-max_angular_acceleration}</min_angular_acceleration>

      <topic>${topic_ns}/cmd_vel</topic>
      <odom_topic>${topic_ns}/odom</odom_topic>
      <tf_topic>${topic_ns}/tf</tf_topic>
      <frame_id>${prefix}odom</frame_id>
      <child_frame_id>${prefix}base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- 바퀴 조인트 각도 → joint_states (robot_state_publisher가 바퀴 TF를 계산) -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>${topic_ns}/joint_states</topic>
      <joint_name>${prefix}left_wheel_joint</joint_name>
      <joint_name>${prefix}right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
