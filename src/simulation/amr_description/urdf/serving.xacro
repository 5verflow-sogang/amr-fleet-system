<?xml version="1.0"?>
<!--
  서빙 로봇 몸체 (body:=serving, 식당 월드용). 실제 서빙로봇 Pudu BellaBot 크기(565 x 537 x 1290 mm, 트레이 여러 단)에 맞춘다:
  바닥 크기는 properties.xacro(body == 'serving'), 여기서는 그 위에 트레이 타워를 얹어 키를 1.29 m로 만든다.
  테이블 상판(약 0.73 m)보다 높아 테이블 밑으로 들어가지 못한다. 경로 계획이 테이블 밑을 피하게 하는 것은
  식당 지도(amr_mapping/maps/restaurant_gt, 로봇 키보다 낮은 상판까지 점유로 칠함)가 맡는다.

  LiDAR 스캔 평면(지면 0.38 m)을 가리지 않게 타워 기둥은 LiDAR 바로 위(지면 0.405 m)에서 시작하고,
  트레이는 0.54 m 위에만 있다. 카메라는 타워 머리(지면 약 1.23 m)로 올라가 앞 아래를 본다 (extrinsics.yaml camera_serving).
  고정 조인트라 SDF 변환 때 base_link로 합쳐진다.

    지면 1.29 ┬ 머리 (카메라, 1.17~1.29)
              │ 기둥 (LiDAR 위, x 0.15)
         1.05 ├──────┐ 트레이 3
         0.80 ├──────┤ 트레이 2
         0.55 ├──────┤ 트레이 1
         0.38 ● LiDAR
         0.33 └ 몸체 (0.565 x 0.537 x 0.3 m)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 지면 기준 높이 → base_link 기준 z -->
  <xacro:property name="tower_x" value="${extrinsics['lidar']['xyz'][0]}"/>
  <xacro:property name="column_radius" value="0.035"/>
  <xacro:property name="column_bottom" value="${0.405 - base_z}"/>
  <xacro:property name="column_top" value="${1.17 - base_z}"/>
  <!-- 트레이는 기둥 앞면에서 로봇 뒤끝까지 -->
  <xacro:property name="tray_front" value="${float(tower_x) + column_radius}"/>
  <xacro:property name="tray_back" value="${-base_length / 2}"/>
  <xacro:property name="tray_length" value="${tray_front - tray_back}"/>
  <!-- 몸체 폭보다 양쪽 3 cm 안쪽 -->
  <xacro:property name="tray_width" value="${base_width - 0.06}"/>
  <xacro:property name="tray_thickness" value="0.02"/>

  <link name="${prefix}tower_column_link">
    <visual>
      <geometry><cylinder radius="${column_radius}" length="${column_top - column_bottom}"/></geometry>
      <material name="serving_white"><color rgba="0.93 0.93 0.9 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${column_radius}" length="${column_top - column_bottom}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="1.5" r="${column_radius}" h="${column_top - column_bottom}"/>
  </link>
  <joint name="${prefix}tower_column_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}tower_column_link"/>
    <origin xyz="${tower_x} 0 ${(column_top + column_bottom) / 2}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="tray" params="index ground_z">
    <link name="${prefix}tray_${index}_link">
      <visual>
        <geometry><box size="${tray_length} ${tray_width} ${tray_thickness}"/></geometry>
        <material name="serving_tray"><color rgba="0.25 0.25 0.27 1"/></material>
      </visual>
      <collision>
        <geometry><box size="${tray_length} ${tray_width} ${tray_thickness}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.8" x="${tray_length}" y="${tray_width}" z="${tray_thickness}"/>
    </link>
    <joint name="${prefix}tray_${index}_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}tray_${index}_link"/>
      <origin xyz="${(tray_front + tray_back) / 2} 0 ${ground_z - base_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:tray index="1" ground_z="0.55"/>
  <xacro:tray index="2" ground_z="0.80"/>
  <xacro:tray index="3" ground_z="1.05"/>

  <!-- 머리: 카메라가 앞면에 붙는다 -->
  <link name="${prefix}tower_head_link">
    <visual>
      <geometry><box size="0.14 0.4 0.12"/></geometry>
      <material name="serving_white"/>
    </visual>
    <collision>
      <geometry><box size="0.14 0.4 0.12"/></geometry>
    </collision>
    <xacro:box_inertia m="0.6" x="0.14" y="0.4" z="0.12"/>
  </link>
  <joint name="${prefix}tower_head_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}tower_head_link"/>
    <origin xyz="${tower_x} 0 ${column_top + 0.06}" rpy="0 0 0"/>
  </joint>

</robot>
