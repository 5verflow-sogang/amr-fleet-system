<?xml version="1.0"?>
<!--
  AMR 치수·질량·동역학 제한. 다른 xacro는 이 값만 참조한다.
  이진(경로 계획·제어)과 민지(오도메트리)가 직접 쓰는 값이므로 바꾸면 PR에 알린다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 몸체 (명세: 600 x 400 x 300 mm) -->
  <xacro:property name="base_length" value="0.6"/>
  <xacro:property name="base_width" value="0.4"/>
  <xacro:property name="base_height" value="0.3"/>
  <xacro:property name="base_mass" value="30.0"/>
  <!-- 몸체 바닥과 지면 사이 간격 -->
  <xacro:property name="ground_clearance" value="0.03"/>

  <!-- 구동 바퀴: 몸체 폭 안에 들어가게 둔다 (좁은 통로 0.6 m 통과 조건) -->
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <xacro:property name="wheel_mass" value="1.5"/>

  <!-- 캐스터: 앞뒤 2개, 마찰 없는 구 -->
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_offset_x" value="0.22"/>
  <xacro:property name="caster_mass" value="0.3"/>

  <!-- 동역학 제한 (명세: 최대 속도 2.0 m/s, 가속도 1.0 m/s², 회전 1.5 rad/s) -->
  <xacro:property name="max_linear_velocity" value="2.0"/>
  <xacro:property name="max_linear_acceleration" value="1.0"/>
  <xacro:property name="max_angular_velocity" value="1.5"/>
  <!-- 명세에 없는 임시값. Nav2 DWB acc_lim_theta(amr_bringup/config/nav2_params.yaml)와 맞춘다 -->
  <xacro:property name="max_angular_acceleration" value="3.2"/>

  <!-- base_footprint(지면) → base_link(몸체 중심) 높이 -->
  <xacro:property name="base_z" value="${ground_clearance + base_height / 2}"/>

  <!-- 관성 모멘트 매크로 -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12}" iyz="0"
               izz="${m * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <!-- 원통 축이 z축일 때 -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12}" iyz="0"
               izz="${m * r * r / 2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2 * m * r * r / 5}" ixy="0" ixz="0"
               iyy="${2 * m * r * r / 5}" iyz="0"
               izz="${2 * m * r * r / 5}"/>
    </inertial>
  </xacro:macro>

</robot>
