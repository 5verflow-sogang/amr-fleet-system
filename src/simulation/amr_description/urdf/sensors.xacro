<?xml version="1.0"?>
<!--
  센서 링크와 Gazebo 센서. 위치는 원 명세서 TF 예시값이다 (base_link 기준).
  사양·노이즈 값은 config/sensors.yaml에서 읽는다. 값은 거기서만 바꾼다.
  센서 시스템(Sensors, Imu)은 월드(amr_gazebo/worlds/warehouse.sdf)에 있다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_xyz" value="0.15 0 0.2"/>
  <xacro:property name="camera_xyz" value="0.18 0 0.25"/>
  <xacro:property name="imu_xyz" value="0 0 0.1"/>

  <xacro:property name="sensors" value="${xacro.load_yaml('$(find amr_description)/config/sensors.yaml')}"/>
  <xacro:property name="lidar" value="${sensors['lidar']}"/>
  <xacro:property name="imu" value="${sensors['imu']}"/>
  <xacro:property name="rgbd" value="${sensors['rgbd_camera']}"/>

  <!-- 360° 스캔은 -π에서 시작해 한 칸 모자란 곳에서 끝내야 시작점과 끝점이 겹치지 않는다 -->
  <xacro:property name="lidar_resolution" value="${radians(lidar['resolution_deg'])}"/>
  <xacro:property name="lidar_samples" value="${int(round(lidar['horizontal_fov'] / lidar['resolution_deg']))}"/>

  <!-- IMU 축 하나의 가우시안 노이즈. spec은 imu['angular_velocity'] 또는 imu['linear_acceleration'] -->
  <xacro:macro name="imu_axis_noise" params="axis spec">
    <xacro:element xacro:name="${axis}">
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>${spec['noise_stddev']}</stddev>
        <bias_mean>${spec['bias_mean']}</bias_mean>
        <bias_stddev>${spec['bias_stddev']}</bias_stddev>
      </noise>
    </xacro:element>
  </xacro:macro>

  <!-- LiDAR -->
  <link name="${prefix}lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="amr_sensor">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="0.04" h="0.05"/>
  </link>

  <joint name="${prefix}lidar_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
    <origin xyz="${lidar_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- 카메라 (링크는 ROS 관례 x 전방, 광학 프레임은 z 전방·x 오른쪽·y 아래) -->
  <link name="${prefix}camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.1 0.03"/>
      </geometry>
      <material name="amr_sensor"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.1 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.03" y="0.1" z="0.03"/>
  </link>

  <joint name="${prefix}camera_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}camera_link"/>
    <origin xyz="${camera_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}camera_optical_frame"/>

  <joint name="${prefix}camera_optical_joint" type="fixed">
    <parent link="${prefix}camera_link"/>
    <child link="${prefix}camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- IMU (몸체 안쪽) -->
  <link name="${prefix}imu_link"/>

  <joint name="${prefix}imu_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

  <!--
    Gazebo 센서. URDF 고정 조인트는 SDF 변환 때 base_link로 합쳐지므로
    ignition_frame_id로 메시지 frame_id를 TF 트리의 센서 링크 이름에 맞춘다.
    토픽은 원본(*_raw)이다. 인계 계약의 /scan, /imu/data는 amr_odometry 필터 출력이다.
  -->
  <gazebo reference="${prefix}lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${lidar['update_rate']}</update_rate>
      <topic>${topic_ns}/scan_raw</topic>
      <ignition_frame_id>${prefix}lidar_link</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${-pi + (lidar_samples - 1) * lidar_resolution}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar['range_min']}</min>
          <max>${lidar['range_max']}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>${lidar['noise']['type']}</type>
          <mean>${lidar['noise']['mean']}</mean>
          <stddev>${lidar['noise']['stddev']}</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!--
    RGB와 Depth를 한 센서로 낸다. 센서는 camera_link의 +x를 보고, 메시지 frame_id는 광학 프레임이다.
    Gazebo 토픽 camera/{image, depth_image, camera_info}는 spawn_robot.launch.py가 ROS 이름으로 바꾼다.
    enable_camera가 false면 센서를 만들지 않는다 (링크·TF는 위에서 그대로 만든다).
  -->
  <xacro:if value="${enable_camera}">
  <gazebo reference="${prefix}camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${rgbd['update_rate']}</update_rate>
      <topic>${topic_ns}/camera</topic>
      <ignition_frame_id>${prefix}camera_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>${radians(rgbd['horizontal_fov'])}</horizontal_fov>
        <image>
          <width>${rgbd['width']}</width>
          <height>${rgbd['height']}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${rgbd['range_min']}</near>
          <far>${rgbd['range_max']}</far>
        </clip>
        <depth_camera>
          <clip>
            <near>${rgbd['range_min']}</near>
            <far>${rgbd['range_max']}</far>
          </clip>
        </depth_camera>
        <noise>
          <type>${rgbd['depth_noise']['type']}</type>
          <mean>${rgbd['depth_noise']['mean']}</mean>
          <stddev>${rgbd['depth_noise']['stddev']}</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>

  <!--
    라벨 카메라 (YOLO 학습 데이터 수집 전용, label_camera:=true). RGBD 카메라와 같은 링크·화각·해상도라
    같은 시각의 RGB 영상과 픽셀이 맞는다. Label 플러그인이 붙은 모델마다 화면에 보이는 부분의 2D 상자를 낸다
    (가려진 부분은 빼고, 모델 단위로 하나). ROS: /<ns>/camera/labels (vision_msgs/Detection2DArray)
  -->
  <xacro:if value="${label_camera}">
  <gazebo reference="${prefix}camera_link">
    <sensor name="label_camera" type="boundingbox_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>${topic_ns}/camera/labels</topic>
      <ignition_frame_id>${prefix}camera_optical_frame</ignition_frame_id>
      <camera>
        <box_type>2d</box_type>
        <horizontal_fov>${radians(rgbd['horizontal_fov'])}</horizontal_fov>
        <image>
          <width>${rgbd['width']}</width>
          <height>${rgbd['height']}</height>
        </image>
        <clip>
          <near>${rgbd['range_min']}</near>
          <far>${rgbd['range_max']}</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>

  <gazebo reference="${prefix}imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>${imu['update_rate']}</update_rate>
      <topic>${topic_ns}/imu/data_raw</topic>
      <ignition_frame_id>${prefix}imu_link</ignition_frame_id>
      <imu>
        <angular_velocity>
          <xacro:imu_axis_noise axis="x" spec="${imu['angular_velocity']}"/>
          <xacro:imu_axis_noise axis="y" spec="${imu['angular_velocity']}"/>
          <xacro:imu_axis_noise axis="z" spec="${imu['angular_velocity']}"/>
        </angular_velocity>
        <linear_acceleration>
          <xacro:imu_axis_noise axis="x" spec="${imu['linear_acceleration']}"/>
          <xacro:imu_axis_noise axis="y" spec="${imu['linear_acceleration']}"/>
          <xacro:imu_axis_noise axis="z" spec="${imu['linear_acceleration']}"/>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
