Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /amr_01/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (DiffDrive)
      Enabled: true
      Topic:
        Value: /amr_01/diff_drive/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 100
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.5
        Shaft Radius: 0.03
        Head Length: 0.15
        Head Radius: 0.08
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (raw)
      Enabled: true
      Topic:
        Value: /amr_01/scan_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Safety (amr_safety)
      Enabled: true
      Topic:
        Value: /amr_01/safety/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: E-Stop button
      Enabled: true
      Interactive Markers Namespace: /amr_01/estop_button
      Show Descriptions: false
      Show Axes: false
      Show Visual Aids: false
      Enable Transparency: true
  Global Options:
    Fixed Frame: amr_01/odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.9
      Target Frame: amr_01/base_link
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
